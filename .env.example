# Copy to .env (never commit .env). All values are optional.
REPOLENS_DATA_DIR=./data
REPOLENS_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
REPOLENS_MAX_FILES=300
REPOLENS_MAX_FILE_BYTES=200000
REPOLENS_MAX_TOTAL_BYTES=5000000
REPOLENS_CHUNK_LINES=40
REPOLENS_CHUNK_OVERLAP=8
REPOLENS_CLONE_TIMEOUT_SECONDS=120
REPOLENS_MIN_SCORE=0.25

# Optional LLM (any OpenAI-compatible /chat/completions endpoint, e.g. a local Ollama server).
# Leave REPOLENS_LLM_MODEL empty to run in retrieval-only mode.
REPOLENS_LLM_BASE_URL=http://localhost:11434/v1
REPOLENS_LLM_MODEL=
REPOLENS_LLM_API_KEY=
